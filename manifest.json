{
  "name": "GitHub Code Counter",
  "version": "1.1.0",
  "description": "A Chrome extension to count lines of code in public/private GitHub repositories.",
  "manifest_version": 3,
  "author": "Maisha Supritee Chowdhury",
  "icons": {
    "16": "icons/16.PNG",
    "32": "icons/32.PNG",
    "48": "icons/48.PNG",
    "128": "icons/128.PNG"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitHub Code Counter",
    "default_icon": {
      "16": "icons/16.PNG",
      "32": "icons/32.PNG",
      "48": "icons/48.PNG",
      "128": "icons/128.PNG"
    }
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": ["https://api.github.com/*"]
}
